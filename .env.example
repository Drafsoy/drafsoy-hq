# Copia este archivo como ".env" y rellena los valores.
# El archivo .env NUNCA se sube a GitHub.

# --- Supabase (Project Settings -> API) ---
# Estas dos las usa la pantalla. La "anon" es pública; la seguridad la dan las reglas de la base de datos.
RENDERER_VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
RENDERER_VITE_SUPABASE_ANON_KEY=eyJ...

# --- Anthropic (console.anthropic.com -> API Keys) ---
# Solo la lee "el cerebro" de la app. Nunca llega a la pantalla.
ANTHROPIC_API_KEY=sk-ant-...

# --- Google (Drive y Calendar) · opcional ---
# Google Cloud Console -> APIs y servicios -> Credenciales -> Crear ID de cliente OAuth -> "App de escritorio".
# Solo los lee "el cerebro". Luego pulsa "Conectar Google" en Ajustes.
GOOGLE_CLIENT_ID=123-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
